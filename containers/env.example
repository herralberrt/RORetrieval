# Environment for the RORetrieval container.
#
#   cp containers/env.example containers/env.sh
#   # edit it, then:
#   source containers/env.sh
#
# containers/env.sh is gitignored - never commit your token.

# --- HuggingFace -----------------------------------------------------------
# Gemma 3 is a gated model, and the license is accepted per repository.
# Accept it for the model you actually run - https://huggingface.co/google/gemma-3-27b-it
# - and create a read token at https://huggingface.co/settings/tokens
export HF_TOKEN="hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Where model weights are cached. Leave this unset to let
# scripts/hf_cache_dir.sh pick: the home cache when the weights fit, node-local
# scratch when they do not. The bf16 27B checkpoint is ~55 GiB and a student
# home on fep.grid.pub.ro is capped at 50 GiB, so 27B lands in scratch and is
# re-fetched per node (a compute node gets ~70 MB/s per stream, so a cold
# 27B cache costs a few minutes of the time budget).
# export HF_HOME="$HOME/.cache/huggingface"

# Set to 1 on compute nodes with no internet access (weights must already be
# in HF_HOME - download them once from the login node).
# export HF_HUB_OFFLINE=1

# --- Generation defaults ---------------------------------------------------
export GEMMA_MODEL="google/gemma-3-27b-it"
export QGEN_BACKEND="auto"                       # auto | vllm | transformers
export QGEN_OUTPUT="data/queries/queries_gemma3_27b.jsonl"
export QGEN_TIME_BUDGET_MIN=110                  # stop cleanly inside a 2h job

# --- Cluster / SLURM -------------------------------------------------------
export IMAGE="$PWD/containers/roretrieval.sif"
export PARTITION="dgxa100"                       # 8x A100-SXM4-80GB; dgxh100 also
                                                 # works for the `student` account
export GRES="gpu:1"                              # 27B bf16 needs one 80GB card
export JOB_TIME="02:00:00"
export CPUS_PER_TASK=16
export JOB_MEM="128G"

# Variables that must reach *inside* the container get the APPTAINERENV_ prefix.
export APPTAINERENV_HF_TOKEN="$HF_TOKEN"
# APPTAINERENV_HF_HOME is set by the SLURM script after it picks the cache.
