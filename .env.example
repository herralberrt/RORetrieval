# ============================================================
#  Copy this file to .env and put ONE API key below.
#      cp .env.example .env
#  Then check it works:
#      python src/llm_client.py
# ============================================================

# --- Option A: Claude (Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-5
# Other options: claude-sonnet-5 (cheaper), claude-haiku-4-5 (cheapest)

# --- Option B: OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG_ID=org-your-org-id
OPENAI_MODEL=gpt-4o-mini

# Which provider to use. Leave empty to auto-detect from whichever key is set.
LLM_PROVIDER=

# Sampling temperature for query generation (0.5 = focused, 1.0 = diverse).
# Note: claude-opus-5 / claude-sonnet-5 reject a temperature parameter;
# src/llm_client.py maps this onto their `effort` setting instead.
TEMPERATURE=0.8

# Alternative: Use local Ollama or HuggingFace Inference API
# OLLAMA_MODEL=llama2
# HF_API_KEY=hf_your_key_here

# Data paths
DATA_DIR=data
RESULTS_DIR=results
MODELS_DIR=models

# Embeddings model (for dense retrieval + the FAISS index).
# ONE shared choice -- everything downstream must use the same model or the
# vectors are not comparable. The FAISS index records which model built it.
EMBEDDINGS_MODEL=sentence-transformers/all-mpnet-base-v2
# Alternative, multilingual (has Romanian in training data; mpnet does not):
# EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
