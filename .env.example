# OpenAI API Configuration
OPENAI_API_KEY=sk-your-key-here
OPENAI_ORG_ID=org-your-org-id
OPENAI_MODEL=gpt-4
TEMPERATURE=0.8

# Alternative: Use local Ollama or HuggingFace Inference API
# OLLAMA_MODEL=llama2
# HF_API_KEY=hf_your_key_here

# Data paths
DATA_DIR=data
RESULTS_DIR=results
MODELS_DIR=models

# Embeddings model (for dense retrieval)
EMBEDDINGS_MODEL=sentence-transformers/multilingual-e5-large
